/*
 * 💰 Ad Loader — drop-in, self-configuring ad monetization client
 * Generated by uncensored-coder/monetization. Do not edit by hand;
 * regenerate with:  python -m monetization.cli build
 *
 * What it does, with zero effort from you:
 *   - injects ad slots into the highest-paying positions on every page
 *   - lazy-loads them (page stays fast, Core Web Vitals stay green)
 *   - stacks multiple ad networks with fallback to maximize fill rate
 *   - shows a consent bar so personalized (higher-CPM) ads can serve legally
 */
(function () {
  "use strict";

  // ---- Injected configuration (filled in at build time) -------------------
  var CONFIG = __AD_CONFIG__;

  if (window.__adLoaderStarted) return;       // guard against double-injection
  window.__adLoaderStarted = true;

  // ---- Consent (GDPR/CCPA) ------------------------------------------------
  // Personalized ads pay multiples of non-personalized ones, but require
  // consent in many regions. We default to non-personalized until accepted.
  function hasConsent() {
    try { return localStorage.getItem("ad_consent") === "yes"; } catch (e) { return false; }
  }

  function showConsentBar() {
    if (!CONFIG.respect_consent || hasConsent()) { loadNetworks(); return; }
    if (document.getElementById("ad-consent-bar")) return;
    var bar = document.createElement("div");
    bar.id = "ad-consent-bar";
    bar.style.cssText =
      "position:fixed;bottom:0;left:0;right:0;z-index:2147483646;background:#1a1a1a;" +
      "color:#eee;font:14px/1.5 system-ui,sans-serif;padding:14px 18px;display:flex;" +
      "flex-wrap:wrap;gap:10px;align-items:center;justify-content:center;box-shadow:0 -2px 12px rgba(0,0,0,.4)";
    bar.innerHTML =
      '<span>This site uses cookies for ads &amp; analytics. Accept to support us with personalized ads.</span>' +
      '<button id="ad-consent-yes" style="background:#16a34a;color:#fff;border:0;padding:8px 18px;border-radius:6px;cursor:pointer;font-weight:600">Accept</button>' +
      '<button id="ad-consent-no" style="background:#444;color:#fff;border:0;padding:8px 18px;border-radius:6px;cursor:pointer">Reject</button>';
    document.body.appendChild(bar);
    document.getElementById("ad-consent-yes").onclick = function () {
      try { localStorage.setItem("ad_consent", "yes"); } catch (e) {}
      bar.remove(); loadNetworks();
    };
    document.getElementById("ad-consent-no").onclick = function () {
      try { localStorage.setItem("ad_consent", "no"); } catch (e) {}
      bar.remove(); loadNetworks();   // still load, but non-personalized
    };
  }

  // ---- Script loader helper ----------------------------------------------
  function loadScript(src, attrs) {
    var s = document.createElement("script");
    s.src = src; s.async = true; s.crossOrigin = "anonymous";
    if (attrs) Object.keys(attrs).forEach(function (k) { s.setAttribute(k, attrs[k]); });
    document.head.appendChild(s);
    return s;
  }

  // ---- Network bootstrappers ("plug in whatever you gotta plug in") -------
  function loadNetworks() {
    var n = CONFIG.networks;

    if (n.adsense && n.adsense.enabled) {
      loadScript(
        "https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=" + n.adsense.publisher_id,
        { "data-ad-client": n.adsense.publisher_id }
      );
    }
    if (n.medianet && n.medianet.enabled) {
      window._mNHandle = window._mNHandle || {};
      window._mNHandle.queue = window._mNHandle.queue || [];
      window.medianet_versionId = "3121199";
      loadScript("https://contextual.media.net/dmedianet.js?cid=" + n.medianet.customer_id);
    }
    if (n.ezoic && n.ezoic.enabled) {
      window.ezstandalone = window.ezstandalone || {};
      window.ezstandalone.cmd = window.ezstandalone.cmd || [];
      loadScript("https://www.ezojs.com/ezoic/sa.min.js");
    }
    if (n.propeller && n.propeller.enabled) {
      loadScript("https://upgulpinon.com/1?z=" + n.propeller.zone_id);
    }

    placeSlots();
  }

  // ---- Slot creation & placement ------------------------------------------
  function makeSlot(placement) {
    var wrap = document.createElement("div");
    wrap.className = "ad-slot ad-slot--" + placement;
    wrap.setAttribute("data-ad-placement", placement);
    wrap.style.cssText = "margin:18px auto;text-align:center;max-width:100%;overflow:hidden;min-height:90px";

    if (CONFIG.label_ads) {
      var label = document.createElement("div");
      label.textContent = "Advertisement";
      label.style.cssText = "font:11px sans-serif;color:#999;letter-spacing:.5px;text-transform:uppercase;margin-bottom:4px";
      wrap.appendChild(label);
    }
    return wrap;
  }

  function fillSlot(wrap, placement) {
    if (wrap.getAttribute("data-filled")) return;
    wrap.setAttribute("data-filled", "1");
    var n = CONFIG.networks;

    // Direct/house banner takes priority (100% margin, always fills).
    if (n.direct && n.direct.enabled) {
      var b = (n.direct.banners || []).find(function (x) { return x.placement === placement; });
      if (b) {
        wrap.innerHTML += '<a href="' + b.url + '" rel="sponsored noopener" target="_blank">' +
          '<img src="' + b.image + '" alt="Sponsor" style="max-width:100%;height:auto;border:0"></a>';
        return;
      }
    }

    // AdSense unit for this placement.
    if (n.adsense && n.adsense.enabled && n.adsense.slots && n.adsense.slots[placement]) {
      var ins = document.createElement("ins");
      ins.className = "adsbygoogle";
      ins.style.cssText = "display:block";
      ins.setAttribute("data-ad-client", n.adsense.publisher_id);
      ins.setAttribute("data-ad-slot", n.adsense.slots[placement]);
      ins.setAttribute("data-ad-format", "auto");
      ins.setAttribute("data-full-width-responsive", "true");
      wrap.appendChild(ins);
      try { (window.adsbygoogle = window.adsbygoogle || []).push({}); } catch (e) {}
      return;
    }

    // Ezoic placeholder (Ezoic fills by id at runtime).
    if (n.ezoic && n.ezoic.enabled) {
      var id = 100 + Math.floor(Math.random() * 900);
      var d = document.createElement("div");
      d.id = "ezoic-pub-ad-placeholder-" + id;
      wrap.appendChild(d);
      window.ezstandalone.cmd.push(function () { window.ezstandalone.showAds(id); });
    }
  }

  function insertAt(container, position, node) {
    if (position === "afterbegin") { container.insertBefore(node, container.firstChild); }
    else if (position === "beforeend") { container.appendChild(node); }
    else if (position === "middle") {
      var kids = container.children;
      container.insertBefore(node, kids[Math.floor(kids.length / 2)] || null);
    }
  }

  function placeSlots() {
    // Word-count gate: skip ads on thin pages to protect your account.
    if (CONFIG.min_content_words > 0) {
      var words = (document.body.innerText || "").trim().split(/\s+/).length;
      if (words < CONFIG.min_content_words) return;
    }

    var observer = ("IntersectionObserver" in window) ? new IntersectionObserver(function (entries, obs) {
      entries.forEach(function (en) {
        if (en.isIntersecting) {
          fillSlot(en.target, en.target.getAttribute("data-ad-placement"));
          obs.unobserve(en.target);
        }
      });
    }, { rootMargin: (CONFIG.lazy_margin_px || 600) + "px" }) : null;

    CONFIG.placements.forEach(function (p) {
      if (!p.enabled) return;
      var targets = document.querySelectorAll(p.selector);
      if (!targets.length) return;
      var slot = makeSlot(p.placement);
      insertAt(targets[0], p.position, slot);

      if (CONFIG.lazy_load && observer) observer.observe(slot);
      else fillSlot(slot, p.placement);
    });

    if (CONFIG.sticky_footer) buildStickyFooter();
    if (CONFIG.refresh_seconds > 0) startRefresh();
  }

  // ---- Sticky anchored footer (very high mobile RPM) ----------------------
  function buildStickyFooter() {
    if (document.getElementById("ad-sticky-footer")) return;
    var bar = document.createElement("div");
    bar.id = "ad-sticky-footer";
    bar.style.cssText =
      "position:fixed;bottom:0;left:0;right:0;z-index:2147483645;background:rgba(255,255,255,.96);" +
      "border-top:1px solid #ddd;text-align:center;padding:2px 0;min-height:50px";
    var close = document.createElement("button");
    close.textContent = "✕";
    close.style.cssText = "position:absolute;top:-22px;right:6px;border:0;background:#1a1a1a;color:#fff;width:22px;height:22px;border-radius:4px 4px 0 0;cursor:pointer";
    close.onclick = function () { bar.remove(); };
    bar.appendChild(close);
    var inner = makeSlot("sticky_footer");
    inner.style.margin = "0 auto";
    bar.appendChild(inner);
    document.body.appendChild(bar);
    fillSlot(inner, "sticky_footer");
  }

  // ---- Optional ad refresh (more impressions per session) -----------------
  function startRefresh() {
    setInterval(function () {
      document.querySelectorAll(".ad-slot[data-filled]").forEach(function (slot) {
        slot.removeAttribute("data-filled");
        slot.innerHTML = "";
        fillSlot(slot, slot.getAttribute("data-ad-placement"));
      });
    }, CONFIG.refresh_seconds * 1000);
  }

  // ---- Boot ---------------------------------------------------------------
  function boot() { if (CONFIG.respect_consent) showConsentBar(); else loadNetworks(); }
  if (document.readyState === "loading") document.addEventListener("DOMContentLoaded", boot);
  else boot();
})();
