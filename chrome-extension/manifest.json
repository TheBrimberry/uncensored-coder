{
  "manifest_version": 3,
  "name": "Omniscient Trading Agent",
  "version": "2.1.0",
  "description": "Your AI trading co-pilot in the browser: live signals with entry/SL/TP, watchlist scanner, price alerts, journal, side panel, chat and one-click server start.",
  "key": "",
  "permissions": ["storage", "notifications", "alarms", "contextMenus", "sidePanel", "nativeMessaging"],
  "host_permissions": [
    "http://127.0.0.1:8765/*",
    "http://localhost:8765/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Omniscient Trading Agent",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "commands": {
    "open-side-panel": {
      "suggested_key": { "default": "Ctrl+Shift+T" },
      "description": "Open the live signals side panel"
    }
  }
}
